{
  "ConnectionStrings": {
    "DocFlowDbContext": "Host=127.0.0.1;Port=55433;Database=docflow;Username=docflow_app"
  },
  "Authentication": {
    "ApiKey": {
      "HeaderName": "X-DocFlow-Api-Key",
      "Clients": []
    }
  },
  "Operations": {
    "Metrics": {
      "Enabled": false,
      "ApiKey": ""
    }
  },
  "Intake": {
    "Idempotency": {
      "RetentionHours": 24,
      "CleanupIntervalSeconds": 3600,
      "CleanupBatchSize": 500
    }
  },
  "Processing": {
    "Retry": {
      "MaxAttempts": 3,
      "RetryDelayMilliseconds": 250
    }
  },
  "Retention": {
    "Enabled": false,
    "DefaultRetentionDays": 30,
    "SweepIntervalSeconds": 3600,
    "BatchSize": 100,
    "TenantOverrides": []
  },
  "FileStorage": {
    "RootPath": "storage"
  },
  "ExtractionWorker": {
    "RootPath": "../DocFlow.Extraction.Worker"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
