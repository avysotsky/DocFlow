# Copy to .env and replace the secret placeholders before running docker compose.
DOCFLOW_POSTGRES_PASSWORD=replace-with-a-strong-database-password
DOCFLOW_API_KEY=replace-with-a-long-random-api-key

# Non-secret deployment defaults.
DOCFLOW_CLIENT_NAME=customer-a
DOCFLOW_CUSTOMER_ID=11111111-1111-1111-1111-111111111111
DOCFLOW_HTTP_PORT=8080

# Optional QuickBooks Online sandbox connection.
# Keep real values in .env only; .env is ignored by git.
DOCFLOW_QBO_ENABLED=false
DOCFLOW_QBO_TARGET_KEY=qbo-sandbox
DOCFLOW_QBO_REALM_ID=replace-with-sandbox-realm-id
DOCFLOW_QBO_CLIENT_ID=replace-with-intuit-development-client-id
DOCFLOW_QBO_CLIENT_SECRET=replace-with-intuit-development-client-secret
DOCFLOW_QBO_REDIRECT_URI=https://replace-with-your-public-host/api/accounting-connections/quickbooks-online/callback
DOCFLOW_QBO_AP_ACCOUNT_ID=replace-after-running-reference-discovery
DOCFLOW_QBO_DEFAULT_EXPENSE_ACCOUNT_ID=replace-after-running-reference-discovery
DOCFLOW_QBO_VENDOR_NAME=replace-with-supplier-name-as-it-appears-in-docflow
DOCFLOW_QBO_VENDOR_ID=replace-after-running-reference-discovery
DOCFLOW_QBO_TAX_RATE=20
DOCFLOW_QBO_TAX_CODE_ID=replace-after-running-reference-discovery
